# ---------------------------------------------------------------------------
# JUNE local development environment. Copy to .env before running.
# Never commit real credentials.
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=
JUNE_ENV=development
JUNE_DEBUG=true
JUNE_SECRET_KEY=
JUNE_FRONTEND_ORIGIN=http://localhost:3000

# Default local database (zero-install). For PostgreSQL use:
# JUNE_DATABASE_URL=postgresql+asyncpg://june:june@localhost:5432/june
JUNE_DATABASE_URL=sqlite+aiosqlite:///./june.db
JUNE_AUTO_CREATE_TABLES=true
JUNE_SEED_ON_START=false
# Optional development-only demo seed. Requires a unique password of at least 16 characters.
JUNE_SEED_PASSWORD=

# Docker Compose PostgreSQL credentials; use a URL-safe password.
POSTGRES_PASSWORD=

# Optional Redis (falls back to in-process cache + event bus)
# JUNE_REDIS_URL=redis://localhost:6379/0

JUNE_ACCESS_TOKEN_MINUTES=30
JUNE_REFRESH_TOKEN_DAYS=7
JUNE_COOKIE_SECURE=false

# Local execution sandbox
JUNE_SANDBOX_DIR=./sandboxes
JUNE_STORAGE_DIR=./storage

# ---------------------------------------------------------------------------
# Optional enterprise integrations. Leave blank to show "Not configured"
# in JUNE with setup guidance. JUNE never fabricates a connected state.
# ---------------------------------------------------------------------------
JUNE_JENKINS_URL=
JUNE_JENKINS_USER=
JUNE_JENKINS_TOKEN=
JUNE_BUILDPIPER_URL=
JUNE_BUILDPIPER_TOKEN=
JUNE_ARGO_URL=
JUNE_ARGO_TOKEN=
JUNE_OPA_URL=
JUNE_KEYCLOAK_ISSUER=
JUNE_OPENBAO_ADDR=
JUNE_OPENBAO_TOKEN=
JUNE_S3_ENDPOINT=
JUNE_S3_BUCKET=
JUNE_GRAFANA_URL=
JUNE_PROMETHEUS_URL=
JUNE_LOKI_URL=

# Frontend
NEXT_PUBLIC_API_BASE=/api/v1
# Local development backend runs on 8010 (see README). Docker compose uses http://backend:8000.
BACKEND_INTERNAL_URL=http://127.0.0.1:8010
