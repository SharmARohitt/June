  "version": "1.0.0",
  "runner": "artifact_export",
  "language": "python",
  "riskLevel": "LOW",
  "inputs": {
    "type": "object",
    "properties": {
      "label": {
        "type": "string",
        "maxLength": 80,
        "default": "release-evidence"
      }
    },
    "additionalProperties": false
  },
  "outputs": {
    "type": "object",
