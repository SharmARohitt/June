{
  "schemaVersion": "1.0",
  "slug": "log-retention-audit",
  "name": "Log Retention Audit",
  "summary": "Audits the sandbox log directory for oversized or expired log files.",
  "version": "1.0.0",
  "runner": "log_audit",
  "language": "python",
  "riskLevel": "LOW",
  "inputs": {
    "type": "object",
    "properties": {
      "max_file_mb": {
        "type": "integer",
        "minimum": 1,
        "maximum": 2048,
        "default": 50
      },
      "older_than_days": {
        "type": "integer",
        "minimum": 1,
        "maximum": 365,
        "default": 30
      }
    },
    "additionalProperties": false
  },
  "outputs": {
    "type": "object",
    "properties": {
      "summary": {
        "type": "string"
      },
      "metrics": {
        "type": "object"
      },
      "details": {
        "type": "object"
      }
    }
  },
  "supportedEnvironments": [
    "uat"
  ],
  "timeoutSeconds": 180,
  "approvalRequired": false,
  "systems": [
    "Isolated UAT sandbox"
  ],
  "requiredPermissions": [
    "executions:create"
  ],
  "dependencies": [],
  "owner": "priya.nair@june.dev",
  "team": "platform-engineering"
}